<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Dedsec.Monitor</AssemblyName>
    <ApplicationIcon>Assets/dedsec.ico</ApplicationIcon>
    <Product>Dedsec Monitor</Product>
    <Description>Game performance. Under your control.</Description>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dedsec.Core/Dedsec.Core.csproj" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <Content Include="../../vendor/PresentMon.exe" Link="tools/PresentMon.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../vendor/PawnIO_setup.exe" Link="tools/PawnIO_setup.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../licenses/**" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
